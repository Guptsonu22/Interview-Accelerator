# ==============================================================================
# Interview Accelerator - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real API keys to version control.

# Server Configuration
ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Uses SQLite for local development. Can be swapped for PostgreSQL (e.g., postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./interview_accelerator.db

# AI / LLM Provider Configuration
# Supported providers: "demo" (default deterministic offline mode), "gemini", "openai", "groq"
# If no provider API key is provided, the application automatically runs in "demo" mode,
# providing full, grounded, deterministic responses without network dependencies.
LLM_PROVIDER=demo

# Optional: Google Gemini API Key (if LLM_PROVIDER=gemini)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI API Key (if LLM_PROVIDER=openai)
# Get a key from https://platform.openai.com/
OPENAI_API_KEY=

# Optional: Groq API Key (if LLM_PROVIDER=groq)
# Get a key from https://console.groq.com/
GROQ_API_KEY=

# Model Overrides (Optional)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
